<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Admin - Quintall</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root{--bg:#fff;--surface:#f8fafc;--border:#e2e8f0;--text:#0f172a;--muted:#64748b;--primary:#0284c7;--accent:#e0f2fe;}
        [data-theme="dark"]{--bg:#0f172a;--surface:#1e293b;--border:#334155;--text:#f8fafc;--muted:#94a3b8;--primary:#38bdf8;--accent:#0369a1;}
        body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--bg);color:var(--text);margin:0;padding:40px 20px;display:flex;justify-content:center;align-items:center;height:100vh;}
        .card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:30px;width:100%;max-width:380px;}
        h1{margin:0 0 8px 0;font-size:20px;font-weight:700;} p{margin:0 0 20px 0;color:var(--muted);font-size:13px;}
        input,button{width:100%;padding:10px 14px;margin-bottom:12px;border:1px solid var(--border);border-radius:6px;font-family:inherit;box-sizing:border-box;}
        button{background:var(--primary);color:#fff;border:none;cursor:pointer;font-weight:600;}
    </style>
</head>
<body>
<div class="card">
    <h1>🔐 Login Admin</h1>
    <p>Masukkan password untuk kelola tugas.</p>
    <form action="/login" method="POST">
        <input type="password" name="password" placeholder="Password admin..." required autofocus>
        <button type="submit">Masuk</button>
    </form>
    <p style="text-align:center;margin-top:14px;"><a href="/" style="color:var(--primary);text-decoration:none;font-size:12px;">← Kembali ke Beranda</a></p>
</div>
</body>
</html>